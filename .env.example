# Copy to .env at the repository root; never commit real credentials.
# Existing TBot names are supported unchanged. Only Telegram is reused.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional alternative to TELEGRAM_BOT_TOKEN (wins within the same source).
# TRADEE_TELEGRAM_BOT_TOKEN=

# Leave empty for viewer-only dashboard access. Set your own random token to
# enable operator requests; paste it into dashboard Settings for that session.
TRADEE_WEB_OPERATOR_TOKEN=

# Binance public market data needs no API keys. Groq/Angel One/Flask/Postgres
# configuration from TBot has no consumer in Tradee and is not copied.
